<?xml version="1.0" encoding="utf-8"?>
<!--
  Un equipo detectado en la tira horizontal sobre la cámara, estilo Historias:
  círculo con su foto y el nombre debajo. Tocarlo abre el mismo modal que tocar
  la caja en la vista de detección.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/chipFoto"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circulo_avatar_chat"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:padding="2dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/chipNombre"
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="Balanza Analítica" />

</LinearLayout>
