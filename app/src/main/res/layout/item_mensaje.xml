<?xml version="1.0" encoding="utf-8"?>
<!--
  Un único layout para los tres tipos de mensaje (usuario, Rumi y error).
  El adaptador cambia la alineación, el fondo, el color del texto y la visibilidad
  del avatar según el origen: tres layouts casi idénticos serían más código para el
  mismo resultado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/burbujaContenedor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:id="@+id/burbujaFila"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Avatar de Rumi: solo en sus mensajes -->
        <ImageView
            android:id="@+id/mensajeAvatar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/circulo_blanco"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_rumi"
            android:contentDescription="@string/chat_desc_avatar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mensajeTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="290dp"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.2"
                tools:text="La estufa se enciende con el interruptor principal." />

            <TextView
                android:id="@+id/mensajeFuentes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                android:maxWidth="290dp"
                android:textColor="@color/texto_secundario"
                android:textSize="11sp"
                android:textStyle="italic"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
