<?xml version="1.0" encoding="utf-8"?>
<!--
  Hoja inferior que aparece al tocar un equipo detectado.

  Sigue las guías de identidad del proyecto: chip de confianza en verde claro,
  tarjetas con icono sobre fondo de color, y el código verde = información /
  dorado = acción con IA.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fondo_modal"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- Asa de arrastre -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/asa_modal" />

    <TextView
        android:id="@+id/modalChipConfianza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_verde"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:textColor="@color/verde_institucional"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Identificado con 85%" />

    <TextView
        android:id="@+id/modalNombreEquipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/texto_principal"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Estufa de Secado ANKOM" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="@string/modal_subtitulo"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <!-- Ver ficha técnica: funciona siempre, también sin internet -->
    <LinearLayout
        android:id="@+id/modalBotonFicha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/tarjeta_verde"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="@null"
            app:tint="@color/verde_institucional" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modal_ficha_titulo"
                android:textColor="@color/verde_institucional"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalFichaDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modal_ficha_detalle"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chat con Rumi: necesita internet -->
    <LinearLayout
        android:id="@+id/modalBotonChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/tarjeta_dorada"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/modalIconoRumi"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_rumi"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modalChatTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modal_chat_titulo"
                android:textColor="@color/verde_institucional"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modalChatDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modal_chat_detalle"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
