<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite HTTP sin cifrar SOLO hacia el backend de desarrollo.

  Android bloquea el trafico en claro desde la version 9, y con razon. En lugar de
  desactivar esa proteccion en toda la app (usesCleartextTraffic="true"), se abre
  una excepcion para las direcciones locales:
    10.0.2.2  -> el "localhost" del PC visto desde el emulador
    localhost -> pruebas en el propio dispositivo

  Cuando el backend este publicado con HTTPS, este archivo se puede borrar.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
